{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IngeCalc",
  "version": "0.1.2",
  "identifier": "org.ingecalc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Education",
    "shortDescription": "Open-source engineering calculation worksheet",
    "longDescription": "IngeCalc is an open-source engineering calculation worksheet for Linux and Windows with a Rust core, MathLive editing and JSON documents."
  }
}
