          "type": "math",
          "x": 60,
          "y": 84,
          "w": 720,
          "h": 72,
          "source": "\\frac{\\mathrm{fib}(21)}{\\mathrm{fib}(20)}",
          "ascii": "fib(21)/fib(20)"
        },
