          "w": 720,
          "h": 36,
          "html": "<p><strong>Identidad de Cassini</strong></p>"
        },
        {
          "id": "note-15",
          "type": "text",
          "x": 60,
          "y": 842,
          "w": 720,
          "h": 40,
          "html": "<p>La diferencia alterna entre −1 y 1 según el índice.</p>"
        },
        {
          "id": "math-16",
          "type": "math",
          "x": 60,
          "y": 886,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{fib}(10)^2-\\mathrm{fib}(9)\\cdot\\mathrm{fib}(11)",
          "ascii": "fib(10)^2 - fib(9)*fib(11)"
        },
        {
          "id": "math-17",
          "type": "math",
          "x": 60,
          "y": 944,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{fib}(11)^2-\\mathrm{fib}(10)\\cdot\\mathrm{fib}(12)",
          "ascii": "fib(11)^2 - fib(10)*fib(12)"
        }
      ]
