        {
          "id": "heading-1",
          "type": "text",
          "x": 60,
          "y": 44,
          "w": 720,
          "h": 36,
          "html": "<p><strong>La sucesión de Fibonacci</strong></p>"
        },
        {
          "id": "note-2",
          "type": "text",
          "x": 60,
          "y": 84,
          "w": 720,
          "h": 40,
          "html": "<p>Cada término es la suma de los dos anteriores: 1, 1, 2, 3, 5, 8, 13, …</p>"
        },
        {
          "id": "math-3",
          "type": "math",
          "x": 60,
          "y": 128,
          "w": 720,
          "h": 72,
          "source": "\\varphi := \\frac{1+\\sqrt{5}}{2}",
          "ascii": "phi := (1+sqrt(5))/2"
        },
        {
          "id": "math-4",
          "type": "math",
          "x": 60,
          "y": 204,
          "w": 720,
          "h": 72,
          "source": "\\psi := \\frac{1-\\sqrt{5}}{2}",
          "ascii": "psi := (1-sqrt(5))/2"
        },
        {
          "id": "math-5",
          "type": "math",
          "x": 60,
          "y": 280,
          "w": 720,
          "h": 72,
          "source": "\\mathrm{fib}(n) := \\mathrm{round}\\left(\\frac{\\varphi^n-\\psi^n}{\\sqrt{5}}\\right)",
          "ascii": "fib(n) := round((phi^n - psi^n)/sqrt(5))"
        },
        {
          "id": "heading-6",
          "type": "text",
          "x": 60,
          "y": 356,
          "w": 720,
          "h": 36,
          "html": "<p><strong>Términos de la sucesión</strong></p>"
        },
        {
          "id": "math-7",
          "type": "math",
          "x": 60,
          "y": 396,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{fib}(1)",
          "ascii": "fib(1)"
        },
        {
          "id": "math-8",
          "type": "math",
          "x": 60,
          "y": 454,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{fib}(5)",
          "ascii": "fib(5)"
        },
        {
          "id": "math-9",
          "type": "math",
          "x": 60,
          "y": 512,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{fib}(10)",
          "ascii": "fib(10)"
        },
