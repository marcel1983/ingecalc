          "type": "math",
          "x": 60,
          "y": 160,
          "w": 720,
          "h": 72,
          "source": "\\frac{\\mathrm{fib}(21)}{\\mathrm{fib}(20)}-\\varphi",
          "ascii": "fib(21)/fib(20) - phi"
        },
