        {
          "id": "heading-1",
          "type": "text",
          "x": 60,
          "y": 44,
          "w": 720,
          "h": 36,
          "html": "<p><strong>Conversión automática</strong></p>"
        },
        {
          "id": "note-2",
          "type": "text",
          "x": 60,
          "y": 84,
          "w": 720,
          "h": 40,
          "html": "<p>La suma convierte el operando derecho a la unidad del izquierdo.</p>"
        },
        {
          "id": "math-3",
          "type": "math",
          "x": 60,
          "y": 128,
          "w": 720,
          "h": 54,
          "source": "d := 2\\,\\text{m}+30\\,\\text{cm}",
          "ascii": "d := 2\"m\" + 30\"cm\""
        },
        {
          "id": "math-4",
          "type": "math",
          "x": 60,
          "y": 186,
          "w": 720,
          "h": 54,
          "source": "t := 2\\,\\text{s}",
          "ascii": "t := 2\"s\""
        },
        {
          "id": "math-5",
          "type": "math",
          "x": 60,
          "y": 244,
          "w": 720,
          "h": 72,
          "source": "v := \\frac{d}{t}",
          "ascii": "v := d/t"
        },
        {
          "id": "math-6",
          "type": "math",
          "x": 60,
          "y": 320,
          "w": 720,
          "h": 54,
          "source": "x := v\\cdot t",
          "ascii": "x := v*t"
        },
        {
          "id": "math-7",
          "type": "math",
          "x": 60,
          "y": 378,
          "w": 720,
          "h": 54,
          "source": "T := 20\\,\\text{°C}+5\\,\\text{K}",
          "ascii": "T := 20\"°C\" + 5\"K\""
        },
        {
          "id": "heading-8",
          "type": "text",
          "x": 60,
          "y": 436,
          "w": 720,
          "h": 36,
          "html": "<p><strong>Unidades localizadas</strong></p>"
        },
        {
          "id": "math-9",
          "type": "math",
          "x": 60,
          "y": 476,
          "w": 720,
          "h": 54,
