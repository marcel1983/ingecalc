      "regions": [
        {
          "id": "heading-12",
          "type": "text",
          "x": 60,
          "y": 44,
          "w": 720,
          "h": 36,
          "html": "<p><strong>Unidades propias</strong></p>"
        },
        {
          "id": "note-13",
          "type": "text",
          "x": 60,
          "y": 84,
          "w": 720,
          "h": 40,
          "html": "<p>Una unidad propia se define como múltiplo de otra unidad.</p>"
        },
        {
          "id": "math-14",
          "type": "math",
          "x": 60,
          "y": 128,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{unit}(\\text{mi_pulgada}) := 2.54\\,\\text{cm}",
          "ascii": "unit(\"mi_pulgada\") := 2.54 cm"
        },
        {
          "id": "math-15",
          "type": "math",
          "x": 60,
          "y": 186,
          "w": 720,
          "h": 54,
          "source": "2\\,\\text{mi_pulgada}",
          "ascii": "2\"mi_pulgada\""
        },
        {
          "id": "math-16",
          "type": "math",
          "x": 60,
          "y": 244,
          "w": 720,
          "h": 54,
          "source": "2\\,\\text{mi_pulgada}+2.54\\,\\text{cm}",
          "ascii": "2\"mi_pulgada\" + 2.54 cm"
        },
        {
          "id": "math-17",
          "type": "math",
          "x": 60,
          "y": 302,
          "w": 720,
          "h": 54,
          "source": "\\mathrm{unit}(\\text{mi_pie}) := 12\\,\\text{mi_pulgada}",
          "ascii": "unit(\"mi_pie\") := 12 mi_pulgada"
        },
        {
          "id": "math-18",
          "type": "math",
          "x": 60,
          "y": 360,
          "w": 720,
          "h": 54,
          "source": "1\\,\\text{mi_pie}",
          "ascii": "1\"mi_pie\""
        },
        {
          "id": "math-19",
          "type": "math",
          "x": 60,
          "y": 418,
          "w": 720,
          "h": 54,
          "source": "1\\,\\text{mi_pie}+2\\,\\text{mi_pulgada}",
          "ascii": "1\"mi_pie\" + 2 mi_pulgada"
        },
        {
          "id": "math-20",
          "type": "math",
          "x": 60,
          "y": 476,
          "w": 720,
          "h": 54,
          "source": "0\\,\\text{cm}+1\\,\\text{mi_pie}",
          "ascii": "0\"cm\" + 1\"mi_pie\""
        }
