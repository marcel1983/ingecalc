      "regions": [
        {
          "id": "p1-title",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 62,
          "html": "<p><strong style=\"font-size: 22px\">MEMORIA DE CÁLCULO — TANQUE RECTANGULAR C.A.C</strong></p><p>Análisis sísmico según ACI 350.3 · Reconstrucción de “Dinamico 2.3 cisterna.sm”</p>"
        },
        {
          "id": "p1-h1",
          "type": "text",
          "x": 60,
          "y": 120,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">1. Datos geométricos y materiales</strong></p>"
        },
        {
          "id": "p1-c",
          "type": "math",
          "x": 60,
          "y": 175,
          "w": 730,
          "h": 54,
          "source": "c \\coloneq 12 m",
          "ascii": "c := 12 m"
        },
        {
          "id": "p1-b",
          "type": "math",
          "x": 60,
          "y": 232,
          "w": 730,
          "h": 54,
          "source": "b \\coloneq 4 m",
          "ascii": "b := 4 m"
        },
        {
          "id": "p1-P",
          "type": "math",
          "x": 60,
          "y": 289,
          "w": 730,
          "h": 54,
          "source": "P \\coloneq 2\\cdot c + 2\\cdot b",
          "ascii": "P := 2*c + 2*b"
        },
        {
          "id": "p1-Hw",
          "type": "math",
          "x": 60,
          "y": 346,
          "w": 730,
          "h": 54,
          "source": "Hw \\coloneq 6 m",
          "ascii": "Hw := 6 m"
        },
        {
          "id": "p1-tw",
          "type": "math",
          "x": 60,
          "y": 403,
          "w": 730,
          "h": 54,
          "source": "tw \\coloneq 0.35 m",
          "ascii": "tw := 0.35 m"
        },
        {
          "id": "p1-HL",
          "type": "math",
          "x": 60,
          "y": 460,
          "w": 730,
          "h": 54,
          "source": "HL \\coloneq 5.6 m",
          "ascii": "HL := 5.6 m"
        },
        {
          "id": "p1-gc",
          "type": "math",
          "x": 60,
          "y": 517,
          "w": 730,
          "h": 54,
          "source": "\\gamma_c \\coloneq 2400 kgf/m^3",
          "ascii": "gamma_c := 2400 kgf/m^3"
        },
        {
          "id": "p1-gL",
          "type": "math",
          "x": 60,
          "y": 574,
          "w": 730,
          "h": 54,
          "source": "\\gamma_L \\coloneq 1150 kgf/m^3",
          "ascii": "gamma_L := 1150 kgf/m^3"
        },
        {
          "id": "p1-gs",
          "type": "math",
          "x": 60,
          "y": 631,
          "w": 730,
          "h": 54,
          "source": "\\gamma_s \\coloneq 1800 kgf/m^3",
          "ascii": "gamma_s := 1800 kgf/m^3"
        },
        {
          "id": "p1-phis",
          "type": "math",
          "x": 60,
          "y": 688,
          "w": 730,
          "h": 54,
          "source": "\\phi_s \\coloneq 30",
          "ascii": "phi_s := 30"
        },
        {
          "id": "p1-D",
          "type": "math",
          "x": 60,
          "y": 745,
          "w": 730,
          "h": 54,
          "source": "D \\coloneq 0.1 m",
          "ascii": "D := 0.1 m"
        },
        {
          "id": "p1-Ha",
          "type": "math",
          "x": 60,
          "y": 802,
          "w": 730,
          "h": 54,
          "source": "Ha \\coloneq Hw - D",
          "ascii": "Ha := Hw - D"
        },
        {
          "id": "p1-tt",
          "type": "math",
          "x": 60,
          "y": 859,
          "w": 730,
          "h": 54,
          "source": "t_{techo} \\coloneq 0.25 m",
          "ascii": "t_techo := 0.25 m"
        },
        {
          "id": "p1-Wr",
          "type": "math",
          "x": 60,
          "y": 916,
          "w": 730,
          "h": 54,
          "source": "Wr \\coloneq c\\cdot b\\cdot \\gamma_c\\cdot t_{techo}",
          "ascii": "Wr := c*b*gamma_c*t_techo"
        },
        {
          "id": "p1-Ww",
          "type": "math",
          "x": 60,
          "y": 973,
          "w": 730,
          "h": 54,
          "source": "W_{w} \\coloneq P\\cdot Hw\\cdot tw\\cdot \\gamma_c",
          "ascii": "W_w := P*Hw*tw*gamma_c"
        }
      ]
    },
    {
      "id": "page-2",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p2-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">2. Masa efectiva y masas equivalentes ACI 350.3</strong></p>"
        },
        {
          "id": "p2-eps",
          "type": "math",
          "x": 60,
          "y": 110,
          "w": 730,
          "h": 54,
          "source": "\\epsilon_c \\coloneq \\min(0.0151\\cdot (c/HL)^2 - 0.1908\\cdot (c/HL) + 1.021, 1)",
          "ascii": "epsilon_c := min(0.0151*(c/HL)^2 - 0.1908*(c/HL) + 1.021, 1)"
        },
        {
          "id": "p2-We",
          "type": "math",
          "x": 60,
          "y": 165,
          "w": 730,
          "h": 54,
          "source": "W_{e} \\coloneq \\epsilon_c\\cdot W_{w}",
          "ascii": "W_e := epsilon_c*W_w"
        },
        {
          "id": "p2-WL",
          "type": "math",
          "x": 60,
          "y": 220,
          "w": 730,
          "h": 54,
          "source": "W_{L} \\coloneq HL\\cdot (c - tw)\\cdot (b - tw)\\cdot \\gamma_L",
          "ascii": "W_L := HL*(c - tw)*(b - tw)*gamma_L"
        },
        {
          "id": "p2-Wi",
          "type": "math",
          "x": 60,
          "y": 275,
          "w": 730,
          "h": 54,
          "source": "W_{i} \\coloneq W_{L}\\cdot \\tanh(0.866\\cdot c/HL)/(0.866\\cdot c/HL)",
          "ascii": "W_i := W_L*tanh(0.866*c/HL)/(0.866*c/HL)"
        },
        {
          "id": "p2-Wc",
          "type": "math",
          "x": 60,
          "y": 330,
          "w": 730,
          "h": 54,
          "source": "W_{c} \\coloneq 0.264\\cdot (c/HL)\\cdot \\tanh(3.16\\cdot HL/c)\\cdot W_{L}",
          "ascii": "W_c := 0.264*(c/HL)*tanh(3.16*HL/c)*W_L"
        },
        {
          "id": "p2-hc",
          "type": "math",
          "x": 60,
          "y": 385,
          "w": 730,
          "h": 54,
          "source": "h_{c} \\coloneq (1 - (\\cosh(3.16\\cdot HL/c) - 1)/((3.16\\cdot HL/c)\\cdot \\sinh(3.16\\cdot HL/c)))\\cdot HL",
          "ascii": "h_c := (1 - (cosh(3.16*HL/c) - 1)/((3.16*HL/c)*sinh(3.16*HL/c)))*HL"
        },
        {
          "id": "p2-hi",
          "type": "math",
          "x": 60,
          "y": 440,
          "w": 730,
          "h": 54,
          "source": "h_{i} \\coloneq \\mathrm{if}(c/HL < 1.333, (0.5 - 0.09375\\cdot (c/HL))\\cdot HL, 0.375\\cdot HL)",
          "ascii": "h_i := if(c/HL < 1.333, (0.5 - 0.09375*(c/HL))*HL, 0.375*HL)"
        },
        {
          "id": "p2-Mw",
          "type": "math",
          "x": 60,
          "y": 495,
          "w": 730,
          "h": 54,
          "source": "M_{w} \\coloneq Hw\\cdot tw\\cdot \\gamma_c\\cdot 1 m",
          "ascii": "M_w := Hw*tw*gamma_c*1 m"
        },
        {
          "id": "p2-Mi",
          "type": "math",
          "x": 60,
          "y": 550,
          "w": 730,
          "h": 54,
          "source": "M_{i} \\coloneq (W_{i}/W_{L})\\cdot (c/2)\\cdot HL\\cdot \\gamma_L\\cdot 1 m",
          "ascii": "M_i := (W_i/W_L)*(c/2)*HL*gamma_L*1 m"
        },
        {
          "id": "p2-hw",
          "type": "math",
          "x": 60,
          "y": 605,
          "w": 730,
          "h": 54,
          "source": "h_{w} \\coloneq 0.5\\cdot Hw",
          "ascii": "h_w := 0.5*Hw"
        },
        {
          "id": "p2-h",
          "type": "math",
          "x": 60,
          "y": 660,
          "w": 730,
          "h": 54,
          "source": "h \\coloneq (h_{w}\\cdot M_{w} + h_{i}\\cdot M_{i})/(M_{w} + M_{i})",
          "ascii": "h := (h_w*M_w + h_i*M_i)/(M_w + M_i)"
        },
        {
          "id": "p2-note",
          "type": "text",
          "x": 60,
          "y": 735,
          "w": 730,
          "h": 60,
          "html": "<p><strong>Modelo equivalente:</strong> M<sub>w</sub> es el peso de la pared por unidad de ancho; W<sub>i</sub> y W<sub>c</sub> son los pesos impulsivo y convectivo.</p>"
        }
      ]
    },
    {
      "id": "page-3",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p3-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">3. Propiedades dinámicas y espectro de respuesta</strong></p>"
        },
        {
          "id": "p3-M",
          "type": "math",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 54,
          "source": "M \\coloneq M_{i} + M_{w}",
          "ascii": "M := M_i + M_w"
        },
        {
          "id": "p3-Ec",
          "type": "math",
          "x": 60,
          "y": 160,
          "w": 730,
          "h": 54,
          "source": "E_{c} \\coloneq 57000\\cdot \\sqrt{4500}",
          "ascii": "E_c := 57000*sqrt(4500)"
        },
        {
          "id": "p3-k",
          "type": "math",
          "x": 60,
          "y": 215,
          "w": 730,
          "h": 54,
          "source": "k \\coloneq (E_{c}\\cdot 144/12)\\cdot (tw/h)^3\\cdot ((1 m)/(0.3048 m))/1000",
          "ascii": "k := (E_c*144/12)*(tw/h)^3*((1 m)/(0.3048 m))/1000"
        },
        {
          "id": "p3-Mk",
          "type": "math",
          "x": 60,
          "y": 270,
          "w": 730,
          "h": 54,
          "source": "M_{kip} \\coloneq (M/kgf)\\cdot 2.2046226/1000",
          "ascii": "M_kip := (M/kgf)*2.2046226/1000"
        },
        {
          "id": "p3-omega",
          "type": "math",
          "x": 60,
          "y": 325,
          "w": 730,
          "h": 54,
          "source": "\\omega_i \\coloneq \\sqrt{k\\cdot 32.174/M_{kip}}",
          "ascii": "omega_i := sqrt(k*32.174/M_kip)"
        },
        {
          "id": "p3-Ti",
          "type": "math",
          "x": 60,
          "y": 380,
          "w": 730,
          "h": 54,
          "source": "T_{i} \\coloneq 2\\cdot \\pi/\\omega_i",
          "ascii": "T_i := 2*pi/omega_i"
        },
        {
          "id": "p3-Tc",
          "type": "math",
          "x": 60,
          "y": 435,
          "w": 730,
          "h": 54,
          "source": "T_{c} \\coloneq 4.1203",
          "ascii": "T_c := 4.1203"
        },
        {
          "id": "p3-note",
          "type": "text",
          "x": 60,
          "y": 490,
          "w": 730,
          "h": 48,
          "html": "<p>Ec en psi; k en kip/ft; M<sub>kip</sub> en kip; omega<sub>i</sub> en Hz (modelo equivalente); T<sub>i</sub> y T<sub>c</sub> en s.</p>"
        },
        {
          "id": "p3-S1",
          "type": "math",
          "x": 60,
          "y": 560,
          "w": 730,
          "h": 54,
          "source": "S_{1} \\coloneq 500/981",
          "ascii": "S_1 := 500/981"
        },
        {
          "id": "p3-Ss",
          "type": "math",
          "x": 60,
          "y": 615,
          "w": 730,
          "h": 54,
          "source": "S_{s} \\coloneq 1800/981",
          "ascii": "S_s := 1800/981"
        },
        {
          "id": "p3-Fv",
          "type": "math",
          "x": 60,
          "y": 670,
          "w": 730,
          "h": 54,
          "source": "F_{v} \\coloneq 1.3",
          "ascii": "F_v := 1.3"
        },
        {
          "id": "p3-Fa",
          "type": "math",
          "x": 60,
          "y": 725,
          "w": 730,
          "h": 54,
          "source": "F_{a} \\coloneq 1",
          "ascii": "F_a := 1"
        },
        {
          "id": "p3-Sd1",
          "type": "math",
          "x": 60,
          "y": 780,
          "w": 730,
          "h": 54,
          "source": "S_{d1} \\coloneq (2/3)\\cdot S_{1}\\cdot F_{v}",
          "ascii": "S_d1 := (2/3)*S_1*F_v"
        },
        {
          "id": "p3-Sds",
          "type": "math",
          "x": 60,
          "y": 835,
          "w": 730,
          "h": 54,
          "source": "S_{ds} \\coloneq (2/3)\\cdot S_{s}\\cdot F_{a}",
          "ascii": "S_ds := (2/3)*S_s*F_a"
        },
        {
          "id": "p3-Ts",
          "type": "math",
          "x": 60,
          "y": 890,
          "w": 730,
          "h": 54,
          "source": "T_{s} \\coloneq S_{d1}/S_{ds}",
          "ascii": "T_s := S_d1/S_ds"
        },
        {
          "id": "p3-Ci",
          "type": "math",
          "x": 60,
          "y": 945,
          "w": 730,
          "h": 54,
          "source": "C_{i} \\coloneq \\mathrm{if}(T_{i} \\le  T_{s}, S_{ds}, \\min(S_{d1}/T_{i}, S_{ds}))",
          "ascii": "C_i := if(T_i <= T_s, S_ds, min(S_d1/T_i, S_ds))"
        },
        {
          "id": "p3-Cc",
          "type": "math",
          "x": 60,
          "y": 1000,
          "w": 730,
          "h": 54,
          "source": "C_{c} \\coloneq \\mathrm{if}(T_{c} \\le  1.6/T_{s}, \\min(1.5\\cdot S_{d1}/T_{c}, 1.5\\cdot S_{ds}), 2.4\\cdot S_{ds}/T_{c}^2)",
          "ascii": "C_c := if(T_c <= 1.6/T_s, min(1.5*S_d1/T_c, 1.5*S_ds), 2.4*S_ds/T_c^2)"
        }
      ]
    },
    {
      "id": "page-4",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p4-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">4. Factores de modificación y fuerzas laterales</strong></p>"
        },
        {
          "id": "p4-Rwi",
          "type": "math",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 54,
          "source": "R_{wi} \\coloneq 3 - (Hw - Ha)/Hw",
          "ascii": "R_wi := 3 - (Hw - Ha)/Hw"
        },
        {
          "id": "p4-Rwc",
          "type": "math",
          "x": 60,
          "y": 160,
          "w": 730,
          "h": 54,
          "source": "R_{wc} \\coloneq 1",
          "ascii": "R_wc := 1"
        },
        {
          "id": "p4-I",
          "type": "math",
          "x": 60,
          "y": 215,
          "w": 730,
          "h": 54,
          "source": "I_{imp} \\coloneq 1",
          "ascii": "I_imp := 1"
        },
        {
          "id": "p4-Pw",
          "type": "math",
          "x": 60,
          "y": 270,
          "w": 730,
          "h": 54,
          "source": "P_{w} \\coloneq I_{imp}\\cdot C_{i}\\cdot \\epsilon_c\\cdot W_{w}/R_{wi}",
          "ascii": "P_w := I_imp*C_i*epsilon_c*W_w/R_wi"
        },
        {
          "id": "p4-Pi",
          "type": "math",
          "x": 60,
          "y": 325,
          "w": 730,
          "h": 54,
          "source": "P_{i} \\coloneq I_{imp}\\cdot C_{i}\\cdot W_{i}/R_{wi}",
          "ascii": "P_i := I_imp*C_i*W_i/R_wi"
        },
        {
          "id": "p4-Pc",
          "type": "math",
          "x": 60,
          "y": 380,
          "w": 730,
          "h": 54,
          "source": "P_{c} \\coloneq I_{imp}\\cdot C_{c}\\cdot W_{c}/R_{wc}",
          "ascii": "P_c := I_imp*C_c*W_c/R_wc"
        },
        {
          "id": "p4-Pwy",
          "type": "math",
          "x": 60,
          "y": 435,
          "w": 730,
          "h": 54,
          "source": "P_{wy} \\coloneq I_{imp}\\cdot C_{i}/R_{wi}\\cdot \\epsilon_c\\cdot (\\gamma_c\\cdot c\\cdot tw)",
          "ascii": "P_wy := I_imp*C_i/R_wi*epsilon_c*(gamma_c*c*tw)"
        },
        {
          "id": "p4-pwy",
          "type": "math",
          "x": 60,
          "y": 490,
          "w": 730,
          "h": 54,
          "source": "p_{wy} \\coloneq P_{wy}/(c\\cdot 2)",
          "ascii": "p_wy := P_wy/(c*2)"
        },
        {
          "id": "p4-B",
          "type": "math",
          "x": 60,
          "y": 545,
          "w": 730,
          "h": 54,
          "source": "B_{v} \\coloneq 2/3",
          "ascii": "B_v := 2/3"
        },
        {
          "id": "p4-Ct",
          "type": "math",
          "x": 60,
          "y": 600,
          "w": 730,
          "h": 54,
          "source": "C_{t} \\coloneq 0.4\\cdot S_{ds}",
          "ascii": "C_t := 0.4*S_ds"
        },
        {
          "id": "p4-av",
          "type": "math",
          "x": 60,
          "y": 655,
          "w": 730,
          "h": 54,
          "source": "av \\coloneq \\min(C_{t}\\cdot I_{imp}\\cdot B_{v}/R_{wi}, 0.2\\cdot S_{ds})",
          "ascii": "av := min(C_t*I_imp*B_v/R_wi, 0.2*S_ds)"
        },
        {
          "id": "p4-q",
          "type": "math",
          "x": 60,
          "y": 710,
          "w": 730,
          "h": 54,
          "source": "q_{hyt} \\coloneq \\gamma_L\\cdot (HL\\cdot c\\cdot HL/2)",
          "ascii": "q_hyt := gamma_L*(HL*c*HL/2)"
        },
        {
          "id": "p4-Phy",
          "type": "math",
          "x": 60,
          "y": 765,
          "w": 730,
          "h": 54,
          "source": "P_{hy} \\coloneq av\\cdot q_{hyt}",
          "ascii": "P_hy := av*q_hyt"
        },
        {
          "id": "p4-note",
          "type": "text",
          "x": 60,
          "y": 835,
          "w": 730,
          "h": 40,
          "html": "<p>P<sub>w</sub>, P<sub>i</sub> y P<sub>c</sub> en kgf; P<sub>wy</sub> en kgf/m; p<sub>wy</sub> en kgf/m².</p>"
        }
      ]
    },
    {
      "id": "page-5",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p5-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">5. Distribución de presiones hidrodinámicas</strong></p>"
        },
        {
          "id": "p5-y1",
          "type": "math",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 54,
          "source": "y1 \\coloneq 0 m",
          "ascii": "y1 := 0 m"
        },
        {
          "id": "p5-y2",
          "type": "math",
          "x": 60,
          "y": 160,
          "w": 730,
          "h": 54,
          "source": "y2 \\coloneq HL",
          "ascii": "y2 := HL"
        },
        {
          "id": "p5-piy1",
          "type": "math",
          "x": 60,
          "y": 230,
          "w": 730,
          "h": 62,
          "source": "p_{iy1} \\coloneq (P_{i}/2)\\cdot (4\\cdot HL - 6\\cdot h_{i} - (6\\cdot HL - 12\\cdot h_{i})\\cdot (y1/HL))/(HL^2\\cdot c)",
          "ascii": "p_iy1 := (P_i/2)*(4*HL - 6*h_i - (6*HL - 12*h_i)*(y1/HL))/(HL^2*c)"
        },
        {
          "id": "p5-piy2",
          "type": "math",
          "x": 60,
          "y": 300,
          "w": 730,
          "h": 62,
          "source": "p_{iy2} \\coloneq (P_{i}/2)\\cdot (4\\cdot HL - 6\\cdot h_{i} - (6\\cdot HL - 12\\cdot h_{i})\\cdot (y2/HL))/(HL^2\\cdot c)",
          "ascii": "p_iy2 := (P_i/2)*(4*HL - 6*h_i - (6*HL - 12*h_i)*(y2/HL))/(HL^2*c)"
        },
        {
          "id": "p5-pcy1",
          "type": "math",
          "x": 60,
          "y": 370,
          "w": 730,
          "h": 62,
          "source": "p_{cy1} \\coloneq (P_{c}/2)\\cdot (4\\cdot HL - 6\\cdot h_{c} - (6\\cdot HL - 12\\cdot h_{c})\\cdot (y1/HL))/(HL^2\\cdot c)",
          "ascii": "p_cy1 := (P_c/2)*(4*HL - 6*h_c - (6*HL - 12*h_c)*(y1/HL))/(HL^2*c)"
        },
        {
          "id": "p5-pcy2",
          "type": "math",
          "x": 60,
          "y": 440,
          "w": 730,
          "h": 62,
          "source": "p_{cy2} \\coloneq (P_{c}/2)\\cdot (4\\cdot HL - 6\\cdot h_{c} - (6\\cdot HL - 12\\cdot h_{c})\\cdot (y2/HL))/(HL^2\\cdot c)",
          "ascii": "p_cy2 := (P_c/2)*(4*HL - 6*h_c - (6*HL - 12*h_c)*(y2/HL))/(HL^2*c)"
        },
        {
          "id": "p5-phy1",
          "type": "math",
          "x": 60,
          "y": 510,
          "w": 730,
          "h": 54,
          "source": "p_{hy1} \\coloneq (av/2)\\cdot \\gamma_L\\cdot y1",
          "ascii": "p_hy1 := (av/2)*gamma_L*y1"
        },
        {
          "id": "p5-phy2",
          "type": "math",
          "x": 60,
          "y": 565,
          "w": 730,
          "h": 54,
          "source": "p_{hy2} \\coloneq (av/2)\\cdot \\gamma_L\\cdot y2",
          "ascii": "p_hy2 := (av/2)*gamma_L*y2"
        },
        {
          "id": "p5-py1",
          "type": "math",
          "x": 60,
          "y": 635,
          "w": 730,
          "h": 72,
          "source": "p_{y1} \\coloneq \\sqrt{(p_{iy1}+p_{wy})^2+p_{cy1}^2+p_{hy1}^2}",
          "ascii": "p_y1 := sqrt(((p_iy1 + p_wy)/(1 kgf/m^2))^2 + (p_cy1/(1 kgf/m^2))^2 + (p_hy1/(1 kgf/m^2))^2)*(1 kgf/m^2)"
        },
        {
          "id": "p5-py2",
          "type": "math",
          "x": 60,
          "y": 715,
          "w": 730,
          "h": 72,
          "source": "p_{y2} \\coloneq \\sqrt{(p_{iy2}+p_{wy})^2+p_{cy2}^2+p_{hy2}^2}",
          "ascii": "p_y2 := sqrt(((p_iy2 + p_wy)/(1 kgf/m^2))^2 + (p_cy2/(1 kgf/m^2))^2 + (p_hy2/(1 kgf/m^2))^2)*(1 kgf/m^2)"
        },
        {
          "id": "p5-note",
          "type": "text",
          "x": 60,
          "y": 800,
          "w": 730,
          "h": 60,
          "html": "<p>Presiones combinadas por unidad de área (kgf/m²). El radicando se normaliza a kgf/m² para extraer la raíz. La presión hidrodinámica se distribuye en la mitad de cada pared perpendicular a la dirección del sismo.</p>"
        }
      ]
    },
    {
      "id": "page-6",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p6-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">6. Empuje sísmico del suelo</strong></p>"
        },
        {
          "id": "p6-Kh",
          "type": "math",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 54,
          "source": "K_{h} \\coloneq 0.33\\cdot S_{s}/2.5",
          "ascii": "K_h := 0.33*S_s/2.5"
        },
        {
          "id": "p6-Kv",
          "type": "math",
          "x": 60,
          "y": 160,
          "w": 730,
          "h": 54,
          "source": "K_{v} \\coloneq 0",
          "ascii": "K_v := 0"
        },
        {
          "id": "p6-phir",
          "type": "math",
          "x": 60,
          "y": 215,
          "w": 730,
          "h": 54,
          "source": "\\phi_{rad} \\coloneq \\phi_s\\cdot\\pi/180",
          "ascii": "phi_rad := phi_s*pi/180"
        },
        {
          "id": "p6-beta",
          "type": "math",
          "x": 60,
          "y": 270,
          "w": 730,
          "h": 54,
          "source": "\\beta \\coloneq 0",
          "ascii": "beta := 0"
        },
        {
          "id": "p6-dw",
          "type": "math",
          "x": 60,
          "y": 325,
          "w": 730,
          "h": 54,
          "source": "\\delta_w \\coloneq 2\\cdot \\phi_{rad}/3",
          "ascii": "delta_w := 2*phi_rad/3"
        },
        {
          "id": "p6-psi",
          "type": "math",
          "x": 60,
          "y": 380,
          "w": 730,
          "h": 54,
          "source": "\\psi_s \\coloneq \\arctan(K_{h}/(1 - K_{v}))",
          "ascii": "psi_s := atan(K_h/(1 - K_v))"
        },
        {
          "id": "p6-thv",
          "type": "math",
          "x": 60,
          "y": 435,
          "w": 730,
          "h": 54,
          "source": "\\theta_v \\coloneq 0",
          "ascii": "theta_v := 0"
        },
        {
          "id": "p6-KAE",
          "type": "math",
          "x": 60,
          "y": 505,
          "w": 730,
          "h": 90,
          "source": "K_{AE} \\coloneq \\frac{(\\cos(\\phi_{rad}-\\psi_s-\\theta_v))^{2}}{\\cos(\\psi_s)\\,(\\cos(\\theta_v))^{2}\\,\\cos(\\psi_s+\\theta_v+\\delta_w)\\left(1+\\sqrt{\\frac{\\sin(\\phi_{rad}+\\delta_w)\\sin(\\phi_{rad}-\\psi_s-\\beta)}{\\cos(\\beta-\\theta_v)\\cos(\\psi_s+\\theta_v+\\delta_w)}}\\right)^{2}}",
          "ascii": "K_AE := (cos(phi_rad - psi_s - theta_v))^2/(cos(psi_s)*(cos(theta_v))^2*cos(psi_s + theta_v + delta_w)*(1 + sqrt(sin(phi_rad + delta_w)*sin(phi_rad - psi_s - beta)/(cos(beta - theta_v)*cos(psi_s + theta_v + delta_w))))^2)"
        },
        {
          "id": "p6-pae",
          "type": "math",
          "x": 60,
          "y": 620,
          "w": 730,
          "h": 54,
          "source": "p_{ae} \\coloneq K_{AE}\\cdot \\gamma_s\\cdot (1 - K_{v})\\cdot Ha",
          "ascii": "p_ae := K_AE*gamma_s*(1 - K_v)*Ha"
        },
        {
          "id": "p6-Pae",
          "type": "math",
          "x": 60,
          "y": 675,
          "w": 730,
          "h": 54,
          "source": "P_{ae} \\coloneq 0.5\\cdot K_{AE}\\cdot \\gamma_s\\cdot (1 - K_{v})\\cdot Ha^2",
          "ascii": "P_ae := 0.5*K_AE*gamma_s*(1 - K_v)*Ha^2"
        },
        {
          "id": "p6-KPE",
          "type": "math",
          "x": 60,
          "y": 745,
          "w": 730,
          "h": 90,
          "source": "K_{PE} \\coloneq \\frac{(\\cos(\\phi_{rad}-\\psi_s+\\theta_v))^{2}}{\\cos(\\psi_s)\\,(\\cos(\\theta_v))^{2}\\,\\cos(\\psi_s-\\theta_v+\\delta_w)\\left(1+\\sqrt{\\frac{\\sin(\\phi_{rad}+\\delta_w)\\sin(\\phi_{rad}-\\psi_s-\\beta)}{\\cos(\\beta+\\theta_v)\\cos(\\psi_s-\\theta_v+\\delta_w)}}\\right)^{2}}",
          "ascii": "K_PE := (cos(phi_rad - psi_s + theta_v))^2/(cos(psi_s)*(cos(theta_v))^2*cos(psi_s - theta_v + delta_w)*(1 + sqrt(sin(phi_rad + delta_w)*sin(phi_rad - psi_s - beta)/(cos(beta + theta_v)*cos(psi_s - theta_v + delta_w))))^2)"
        },
        {
          "id": "p6-ppe",
          "type": "math",
          "x": 60,
          "y": 860,
          "w": 730,
          "h": 54,
          "source": "p_{pe} \\coloneq K_{PE}\\cdot \\gamma_s\\cdot (1 - K_{v})\\cdot Ha",
          "ascii": "p_pe := K_PE*gamma_s*(1 - K_v)*Ha"
        },
        {
          "id": "p6-Ppe",
          "type": "math",
          "x": 60,
          "y": 915,
          "w": 730,
          "h": 54,
          "source": "P_{pe} \\coloneq 0.5\\cdot K_{PE}\\cdot \\gamma_s\\cdot (1 - K_{v})\\cdot Ha^2",
          "ascii": "P_pe := 0.5*K_PE*gamma_s*(1 - K_v)*Ha^2"
        }
      ]
    },
    {
      "id": "page-7",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p7-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">7. Presión del suelo con movimiento restringido</strong></p>"
        },
        {
          "id": "p7-Cr",
          "type": "math",
          "x": 60,
          "y": 110,
          "w": 730,
          "h": 54,
          "source": "Cr \\coloneq 1 - \\sin(\\phi_{rad})",
          "ascii": "Cr := 1 - sin(phi_rad)"
        },
        {
          "id": "p7-Ca",
          "type": "math",
          "x": 60,
          "y": 165,
          "w": 730,
          "h": 54,
          "source": "Ca \\coloneq (1 - \\sin(\\phi_{rad}))/(1 + \\sin(\\phi_{rad}))",
          "ascii": "Ca := (1 - sin(phi_rad))/(1 + sin(phi_rad))"
        },
        {
          "id": "p7-Prep",
          "type": "math",
          "x": 60,
          "y": 220,
          "w": 730,
          "h": 54,
          "source": "P_{rep} \\coloneq Cr\\cdot \\gamma_s\\cdot Ha",
          "ascii": "P_rep := Cr*gamma_s*Ha"
        },
        {
          "id": "p7-Pac",
          "type": "math",
          "x": 60,
          "y": 275,
          "w": 730,
          "h": 54,
          "source": "P_{ac} \\coloneq Ca\\cdot \\gamma_s\\cdot Ha",
          "ascii": "P_ac := Ca*gamma_s*Ha"
        },
        {
          "id": "p7-eq1",
          "type": "math",
          "x": 60,
          "y": 330,
          "w": 730,
          "h": 54,
          "source": "\\sigma_{rep}(Z_{h}) \\coloneq P_{rep} - Cr\\cdot \\gamma_s\\cdot Z_{h}",
          "ascii": "sigma_rep(Z_h) := P_rep - Cr*gamma_s*Z_h"
        },
        {
          "id": "p7-eq2",
          "type": "math",
          "x": 60,
          "y": 385,
          "w": 730,
          "h": 54,
          "source": "\\sigma_{act}(Z_{h}) \\coloneq P_{ac} - Ca\\cdot \\gamma_s\\cdot Z_{h}",
          "ascii": "sigma_act(Z_h) := P_ac - Ca*gamma_s*Z_h"
        },
        {
          "id": "p7-note",
          "type": "text",
          "x": 60,
          "y": 460,
          "w": 730,
          "h": 50,
          "html": "<p>Z<sub>h</sub> es la variable de altura. Las ecuaciones describen la variación lineal de la presión de reposo y activa en el muro.</p>"
        },
        {
          "id": "p7-h2",
          "type": "text",
          "x": 60,
          "y": 540,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">8. Momentos por unidad de ancho</strong></p>"
        },
        {
          "id": "p7-pH",
          "type": "math",
          "x": 60,
          "y": 600,
          "w": 730,
          "h": 54,
          "source": "p_{hidro} \\coloneq \\gamma_L\\cdot HL",
          "ascii": "p_hidro := gamma_L*HL"
        },
        {
          "id": "p7-Mpsad",
          "type": "math",
          "x": 60,
          "y": 655,
          "w": 730,
          "h": 54,
          "source": "M_{psad} \\coloneq P_{ae}\\cdot 0.6\\cdot Ha\\cdot 1 m",
          "ascii": "M_psad := P_ae*0.6*Ha*1 m"
        },
        {
          "id": "p7-Mpspd",
          "type": "math",
          "x": 60,
          "y": 710,
          "w": 730,
          "h": 54,
          "source": "M_{pspd} \\coloneq P_{pe}\\cdot 0.6\\cdot Ha\\cdot 1 m",
          "ascii": "M_pspd := P_pe*0.6*Ha*1 m"
        },
        {
          "id": "p7-MpSh",
          "type": "math",
          "x": 60,
          "y": 765,
          "w": 730,
          "h": 62,
          "source": "M_{pShidro} \\coloneq \\left(\\left(\\left|p_{y2} - p_{y1}\\right|\\cdot HL^2\\cdot(1/6)\\right) + \\left(\\min(p_{y2},p_{y1})\\cdot HL^2\\cdot(1/2)\\right)\\right)\\cdot 1 m",
          "ascii": "M_pShidro := (((abs(p_y2 - p_y1))*HL^2*(1/6)) + (min(p_y2, p_y1)*HL^2*(1/2)))*1 m"
        },
        {
          "id": "p7-Mph",
          "type": "math",
          "x": 60,
          "y": 835,
          "w": 730,
          "h": 54,
          "source": "M_{phidro} \\coloneq p_{hidro}\\cdot HL^2\\cdot (1/6)\\cdot 1 m",
          "ascii": "M_phidro := p_hidro*HL^2*(1/6)*1 m"
        },
        {
          "id": "p7-Mrep",
          "type": "math",
          "x": 60,
          "y": 890,
          "w": 730,
          "h": 54,
          "source": "M_{rep} \\coloneq P_{rep}\\cdot Ha^2\\cdot (1/6)\\cdot 1 m",
          "ascii": "M_rep := P_rep*Ha^2*(1/6)*1 m"
        },
        {
          "id": "p7-note2",
          "type": "text",
          "x": 60,
          "y": 960,
          "w": 730,
          "h": 56,
          "html": "<p><strong>Nota:</strong> se usa |p<sub>y2</sub> − p<sub>y1</sub>| para garantizar que la diferencia de presiones sea positiva; el resultado coincide con el PDF original (9602,7402 kgf·m).</p>"
        }
      ]
    },
    {
      "id": "page-8",
      "width": 850,
      "height": 1100,
      "regions": [
        {
          "id": "p8-h",
          "type": "text",
          "x": 60,
          "y": 46,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">9. Combinaciones críticas y resumen</strong></p>"
        },
        {
          "id": "p8-c1",
          "type": "math",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 54,
          "source": "M_{1} \\coloneq M_{pShidro} + M_{psad} - 1.2\\cdot M_{phidro}",
          "ascii": "M_1 := M_pShidro + M_psad - 1.2*M_phidro"
        },
        {
          "id": "p8-c2",
          "type": "math",
          "x": 60,
          "y": 160,
          "w": 730,
          "h": 54,
          "source": "M_{2} \\coloneq M_{pShidro} - M_{pspd} + 1.2\\cdot M_{phidro}",
          "ascii": "M_2 := M_pShidro - M_pspd + 1.2*M_phidro"
        },
        {
          "id": "p8-c3",
          "type": "math",
          "x": 60,
          "y": 215,
          "w": 730,
          "h": 54,
          "source": "M_{3} \\coloneq 1.4\\cdot M_{phidro}",
          "ascii": "M_3 := 1.4*M_phidro"
        },
        {
          "id": "p8-c4",
          "type": "math",
          "x": 60,
          "y": 270,
          "w": 730,
          "h": 54,
          "source": "M_{4} \\coloneq 1.6\\cdot M_{rep}",
          "ascii": "M_4 := 1.6*M_rep"
        },
        {
          "id": "p8-ratio",
          "type": "math",
          "x": 60,
          "y": 325,
          "w": 730,
          "h": 54,
          "source": "\\mathrm{ratio} \\coloneq M_{pShidro}/M_{phidro}",
          "ascii": "ratio := M_pShidro/M_phidro"
        },
        {
          "id": "p8-critical",
          "type": "text",
          "x": 60,
          "y": 385,
          "w": 730,
          "h": 42,
          "html": "<p><strong style=\"font-size: 18px; color: #b91c1c\">CRÍTICA: 1.6 · M<sub>rep</sub> = 49 290,96 kgf·m</strong></p>"
        },
        {
          "id": "p8-h2",
          "type": "text",
          "x": 60,
          "y": 455,
          "w": 730,
          "h": 32,
          "html": "<p><strong style=\"font-size: 20px\">Resumen de resultados</strong></p>"
        },
        {
          "id": "p8-r1",
          "type": "math",
          "x": 60,
          "y": 510,
          "w": 730,
          "h": 54,
          "source": "W_{w}",
          "ascii": "W_w"
        },
        {
          "id": "p8-r2",
          "type": "math",
          "x": 60,
          "y": 565,
          "w": 730,
          "h": 54,
          "source": "W_{i}",
          "ascii": "W_i"
        },
        {
          "id": "p8-r3",
          "type": "math",
          "x": 60,
          "y": 620,
          "w": 730,
          "h": 54,
          "source": "W_{c}",
          "ascii": "W_c"
        },
        {
          "id": "p8-r4",
          "type": "math",
          "x": 60,
          "y": 675,
          "w": 730,
          "h": 54,
          "source": "P_{w}",
          "ascii": "P_w"
        },
        {
          "id": "p8-r5",
          "type": "math",
          "x": 60,
          "y": 730,
          "w": 730,
          "h": 54,
          "source": "P_{i}",
          "ascii": "P_i"
        },
        {
          "id": "p8-r6",
          "type": "math",
          "x": 60,
          "y": 785,
          "w": 730,
          "h": 54,
          "source": "P_{c}",
          "ascii": "P_c"
        },
        {
          "id": "p8-r7",
          "type": "math",
          "x": 60,
          "y": 840,
          "w": 730,
          "h": 54,
          "source": "P_{ae}",
          "ascii": "P_ae"
        },
        {
          "id": "p8-r8",
          "type": "math",
          "x": 60,
          "y": 895,
          "w": 730,
          "h": 54,
          "source": "M_{4}",
          "ascii": "M_4"
        },
        {
          "id": "p8-note",
          "type": "text",
          "x": 60,
          "y": 955,
          "w": 730,
          "h": 60,
          "html": "<p>Documento reconstruido a partir de “Dinamico 2.3 cisterna.sm”. Revisar y validar por un ingeniero antes de usarlo en diseño.</p>"
        }
      ]
    }
  ]
