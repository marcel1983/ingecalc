          "h": 55,
          "source": "\\text{range}\\left(1,5\\right)",
          "ascii": "range(1,5)"
        },
        {
          "id": "p2-m7",
          "type": "math",
          "x": 60,
          "y": 590,
          "w": 730,
          "h": 55,
          "source": "\\text{dot}\\left(\\left[1,2,3\\right],\\left[4,5,6\\right]\\right)",
