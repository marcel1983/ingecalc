          "type": "math",
          "x": 60,
          "y": 660,
          "w": 730,
          "h": 55,
          "source": "\\text{cross}\\left(\\left[1,0,0\\right],\\left[0,1,0\\right]\\right)",
          "ascii": "cross([1,0,0],[0,1,0])"
        },
        {
          "id": "p2-m9",
          "type": "math",
          "x": 60,
          "y": 730,
          "w": 730,
          "h": 55,
          "source": "\\text{norm}\\left(\\left[3,4\\right]\\right)",
          "ascii": "norm([3,4])"
        },
        {
          "id": "p2-m10",
          "type": "text",
          "x": 60,
          "y": 805,
          "w": 730,
          "h": 66,
          "html": "<p><strong>lu</strong> devuelve L, U y P; <strong>qr</strong> devuelve Q y R. <strong>eigenvalues</strong> trabaja con matrices simétricas.</p>"
        }
      ]
    },
    {
      "id": "page-3",
