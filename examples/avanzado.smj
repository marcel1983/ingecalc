        {
          "id": "p2-mn",
          "type": "text",
          "x": 60,
          "y": 105,
          "w": 730,
          "h": 42,
          "html": "<p>LU, QR, autovalores, rango, vectores y utilidades de matrices.</p>"
        },
        {
          "id": "p2-m1",
          "type": "math",
          "x": 60,
          "y": 170,
          "w": 730,
          "h": 55,
          "source": "A\\coloneq\\left[4,3;6,3\\right]",
          "ascii": "A := [4,3;6,3]"
        },
        {
          "id": "p2-m2",
          "type": "math",
          "x": 60,
